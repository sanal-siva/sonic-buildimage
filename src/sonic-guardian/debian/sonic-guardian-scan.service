[Unit]
Description=SONiC Guardian Periodic Vulnerability Scan
Documentation=https://github.com/sonic-net/SONiC/wiki/Guardian
PartOf=sonic-guardian.service
After=sonic-guardian.service

[Service]
Type=oneshot
User=root
Group=root

# Run the scan
ExecStart=/usr/bin/python3 -m guardian.cli scan now --json

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=sonic-guardian-scan

# Timeout for scan (10 minutes max)
TimeoutStartSec=600

# Don't fail the parent service on scan failure
RemainAfterExit=yes
