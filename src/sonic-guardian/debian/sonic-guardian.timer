[Unit]
Description=SONiC Guardian Periodic Vulnerability Scan Timer
Documentation=https://github.com/sonic-net/SONiC/wiki/Guardian
After=sonic.target
Wants=sonic.target

[Timer]
# Run scan every hour
OnBootSec=5min
OnUnitActiveSec=1h

# Randomize to prevent thundering herd on large deployments
RandomizedDelaySec=5min

# Persist timer state across reboots
Persistent=true

# Run even if system time changes
AccuracySec=1min

Unit=sonic-guardian-scan.service

[Install]
WantedBy=timers.target
