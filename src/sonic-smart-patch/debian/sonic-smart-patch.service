[Unit]
Description=SONiC Smart Patch inventory and evidence synchronization
After=network-online.target database.service docker.service
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/bin/python3 -m smart_patch.main
Restart=on-failure
RestartSec=15
MemoryHigh=80M
MemoryMax=128M
CPUQuota=10%
Nice=15
IOSchedulingClass=idle
TasksMax=32
NoNewPrivileges=yes
PrivateTmp=true
UMask=0077
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
